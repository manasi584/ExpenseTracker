{
  "expo": {
    "name": "Expense-ive",
    "slug": "Expense-ive",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/svgs/logo.svg",
    "scheme": "Expense-ive",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/svgs/logo.svg",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.visioraneft.SaviPay"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/svgs/logo.svg"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/svgs/logo.svg",
          "imageWidth": 200,
          "contentFit": "contain",
          "backgroundColor": "#ffffff"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "91d82b97-46bd-428f-a4ed-27a4874b9284"
      }
    }
  }
}
